{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx --no-install oxlint src 2>&1 | tail -20 || true",
            "timeout": 60,
            "statusMessage": "Linting src"
          }
        ]
      }
    ]
  }
}
